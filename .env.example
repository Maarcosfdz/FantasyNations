# Fantasy Nations — Environment Variables Example
# Copy this file to .env and fill in your values.
# Never commit a real .env file.

# --- Database ---
DATABASE_URL=jdbc:postgresql://localhost:5432/fantasynations
POSTGRES_USER=fantasynations
POSTGRES_PASSWORD=changeme
POSTGRES_DB=fantasynations

# --- Backend server ---
SERVER_PORT=8080

# --- JWT ---
JWT_SECRET=change-this-to-a-long-random-secret-at-least-256-bits
TOKEN_EXPIRATION_SECONDS=86400

# --- Google OAuth2 ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Mail (for forgot password) ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password
MAIL_FROM=noreply@fantasynations.app

# --- Data source ---
# Options: mock | csv | manual | scraping | provider
DATA_SOURCE_MODE=mock

# --- Asset / safe mode ---
PUBLIC_SAFE_MODE=false
SHOW_PLAYER_IMAGES=true
SHOW_TEAM_LOGOS=true
SHOW_STADIUM_IMAGES=false
ALLOW_SCRAPED_DATA=true
ALLOW_SCRAPED_IMAGES=false

# --- Frontend (Next.js public vars) ---
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SAFE_MODE=false
NEXT_PUBLIC_SHOW_PLAYER_IMAGES=true
NEXT_PUBLIC_SHOW_TEAM_LOGOS=true
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
